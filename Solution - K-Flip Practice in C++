class Solution {
public:
    string transform(int n, int k, const string &s) {
        vector<int> ans;
        vector<int> moves;
        int ptr = 0;

        for (int i = 0; i < n; ++i) {
            // Remove moves that no longer affect position i
            while (ptr < (int)moves.size()) {
                if (moves[ptr] + k <= i) ptr++;
                else break;
            }

            int cur = (s[i] == '0') ? 0 : 1;
            int changes = (int)moves.size() - ptr;
            cur ^= (changes % 2);

            if (i + k > n) {
                ans.push_back(cur);
            } else {
                ans.push_back(0);
                if (cur == 1) moves.push_back(i);
            }
        }

        string res;
        res.reserve(ans.size());
        for (int x : ans) res.push_back(char('0' + x));
        return res;
    }
};
