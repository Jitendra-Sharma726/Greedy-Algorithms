#include <bits/stdc++.h>

using namespace std;
const int nax = 1e5 + 5;
int t[nax];
void te() {
    static int n_sum = 0;
    int n;
    scanf("%d", & n);
    n_sum += n;
    assert(n_sum <= 200 * 1000);
    for (int i = 0; i < n; ++i) scanf("%d", & t[i]);
    sort(t, t + n);
    for (int i = 0; i < n - 1; ++i)
        if (t[i] + 1 < t[i + 1]) {
            puts("NO");
            return;
        }
    puts("YES");
}
int main() {
    int T;
    scanf("%d", & T);
    while (T--) te();
}
