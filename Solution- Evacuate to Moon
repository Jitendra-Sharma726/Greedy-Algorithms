#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

void solve() {
    int n, m;
    long long h;
    cin >> n >> m >> h;

    vector<long long> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    vector<long long> b(m);
    for (int i = 0; i < m; i++) {
        cin >> b[i];
    }

    // Sort both arrays in descending order to match largest capacities with largest outlets
    sort(a.rbegin(), a.rend());
    sort(b.rbegin(), b.rend());

    long long max_total_energy = 0;
    // We can only match pairs up to the smaller of the two array sizes
    int limit = min(n, m);

    for (int i = 0; i < limit; i++) {
        // Calculate energy generated by the outlet in H hours
        long long generated_energy = b[i] * h;
        // The car can only store up to its maximum capacity
        max_total_energy += min(a[i], generated_energy);
    }

    cout << max_total_energy << "\n";
}

int main() {
    // Fast I/O for competitive programming
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
